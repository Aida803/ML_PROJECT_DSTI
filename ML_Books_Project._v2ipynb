   "source": [
    "#Check if book is audiobook or printed\n",
    "publication_keyword = r'audio|tantor|listening library|recorded books|books on tape|highbridge|your coach'\n",
    "title_keyword = r'audio|unabridged|abridged|\\bcd\\b|audiobook|spoken|cassette'\n",
    "\n",
    "clean_books['is_audiobook'] = (\n",
    "    clean_books['publisher'].str.contains(publication_keyword, case=False) |\n",
    "    clean_books['title'].str.contains(title_keyword, case=False)\n",
    ").astype(int)\n",
    "print(\"audiobooks flagged:\", clean_books['is_audiobook'].sum())\n",
    "clean_books[clean_books['is_audiobook'] == 1][['title','publisher','is_audiobook']].sample(15)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "9f4c005a-cf70-42ce-b223-4f733fb30566",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Audiobooks with zero pages: 52\n",
      "The median number of pages is 302 and 24 books were affected\n"
     ]
    }
   ],
   "source": [
    "#Replacing number of pages for non audiobooks by the median for books with num_page=0\n",
    "median_pages = clean_books.loc[clean_books[\"num_pages\"] > 0,\"num_pages\"].median()\n",
    "print_books_missing_pages = (clean_books[\"num_pages\"] == 0) & (clean_books[\"is_audiobook\"] == 0)\n",
    "clean_books.loc[print_books_missing_pages, \"num_pages\"] = median_pages\n",
    "print(\"Audiobooks with zero pages:\", clean_books[clean_books[\"num_pages\"]== 0][\"is_audiobook\"].sum())\n",
    "n_affected = print_books_missing_pages.sum()\n",
    "print(f\"The median number of pages is {median_pages:.0f} and {n_affected} books were affected\")"
   ]
  },
