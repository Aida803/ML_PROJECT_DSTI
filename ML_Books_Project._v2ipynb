   "source": [
    "#group authors and publisher and do a frequency encoding\n",
    "clean_books['author_freq'] = clean_books.groupby('authors')['authors'].transform('count')\n",
    "clean_books['publisher_freq'] = clean_books.groupby('publisher')['publisher'].transform('count')\n",
    "clean_books[['title','authors','author_freq','publisher','publisher_freq']].sample(10)"
   ]
  },
