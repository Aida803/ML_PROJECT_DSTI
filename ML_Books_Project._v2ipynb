   "source": [
    "# Mean average_rating by language \n",
    "language_ratings = clean_books.groupby('language_group')['average_rating'].agg(['mean','count'])\n",
    "language_ratings = language_ratings.sort_values('mean')   \n",
    "plt.figure(figsize=(10,6))\n",
