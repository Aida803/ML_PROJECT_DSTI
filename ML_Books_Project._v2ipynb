    "plt.ylim(3.5, 4.3)                                       \n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.title('Mean rating by language (≥20 books)'); plt.ylabel('mean average_rating')\n",
    "plt.show()"
   ]
  },
