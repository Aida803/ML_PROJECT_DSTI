   "source": [
    "#splitting month,day and year and keeping only year to minimize inacurracies\n",
    "clean_books[[\"month\",\"day\",\"year\"]]= clean_books[\"publication_date\"].str.split(\"/\", expand= True)\n",
    "clean_books = clean_books.drop(columns=['publication_date','month','day'])\n",
    "clean_books"
   ]
