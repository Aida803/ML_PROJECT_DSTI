   "source": [
    "#Random forest model ( some feature were not necessarily linear and this model would help us improve our project)\n",
    "rf_model = RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1)\n",
    "rf_model.fit(X_train, y_train)\n",
    "y_pred_rf = rf_model.predict(X_test)\n",
    "print(f\"Random Forest — R2: {r2_score(y_test, y_pred_rf):.3f}  MAE: {mean_absolute_error(y_test, y_pred_rf):.3f}\")"
   ]
  },
