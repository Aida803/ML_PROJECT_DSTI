   "source": [
    "#Dropping rating_count and text_reviews_count  because of redunduncy with log versions\n",
    "clean_books = clean_books.drop(columns=['ratings_count','text_reviews_count'])\n",
    "clean_books.columns.tolist()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 75,
   "id": "3812dacf-6143-4481-a95a-4ef70053cc57",
   "metadata": {},
