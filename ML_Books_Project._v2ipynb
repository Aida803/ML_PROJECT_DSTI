     "name": "stdout",
     "output_type": "stream",
     "text": [
      "number of identical rows: 0\n"
     ]
    }
   ],
   "source": [
    "#check for duplicates for the dataset\n",
    "duplicates = clean_books[clean_books.duplicated()]\n",
    "print(\"number of identical rows:\", len(duplicates))\n"
   ]
