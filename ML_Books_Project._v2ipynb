   ],
   "source": [
    "# Gradient Boosting  model , very little improvement over linear regression\n",
    "gb_model = GradientBoostingRegressor(n_estimators=200, random_state=42)\n",
    "gb_model.fit(X_train, y_train)\n",
    "y_pred_gb = gb_model.predict(X_test)\n",
    "print(f\"Gradient Boosting — R2: {r2_score(y_test, y_pred_gb):.3f}  MAE: {mean_absolute_error(y_test, y_pred_gb):.3f}\")"
   ]
  },
