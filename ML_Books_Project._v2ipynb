   "id": "a42fd634-085d-452a-8324-7155946c3a44",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "title              leading_spaces remaining: 0\n",
      "authors            leading_spaces remaining: 0\n",
      "isbn               leading_spaces remaining: 0\n",
      "language_code      leading_spaces remaining: 0\n",
      "publication_date   leading_spaces remaining: 0\n",
      "publisher          leading_spaces remaining: 0\n"
     ]
    }
   ],
   "source": [
    "#checking for leading spaces in the rest of the dataset\n",
    "clean_books = clean_books.apply(lambda c: c.str.strip() if c.dtype == \"object\" else c)\n",
    "for col in clean_books.select_dtypes(include=\"object\").columns:\n",
    "    s = clean_books[col].astype(str)\n",
    "    print(f\"{col:18s} leading_spaces remaining: {(s != s.str.strip()).sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "8b1fae4c-c932-4083-942f-a10129324f4f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "title              doubles_spaces:     0\n",
      "authors            doubles_spaces:     0\n",
      "isbn               doubles_spaces:     0\n",
      "language_code      doubles_spaces:     0\n",
      "publication_date   doubles_spaces:     0\n",
      "publisher          doubles_spaces:     0\n"
     ]
    }
   ],
   "source": [
    "#checking for double spaces in string columns and removing them\n",
    "for col in ['title', 'authors', 'publisher']:\n",
    "    clean_books[col] = clean_books[col].str.replace(r'\\s+', ' ', regex=True).str.strip()\n",
    "for col in clean_books.select_dtypes(include=\"object\").columns:\n",
    "    s = clean_books[col].astype(str)\n",
    "    doubles  = s.str.contains(r\"\\s{2,}\", regex=True).sum()\n",
    "    print(f\"{col:18s} doubles_spaces: {doubles:5d}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "d36b0317-5632-48ea-b119-59761bd89a0c",
   "metadata": {},
